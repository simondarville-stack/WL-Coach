# TypeScript incremental build cache
*.tsbuildinfo

# Vite writes a temp compiled config next to vite.config.ts when it loads it
vite.config.ts.timestamp-*.mjs

# Netlify CLI local state — machine-specific (absolute publish paths).
.netlify/
.wrangler/

# Seeded design-canvas pages: ~2.5 MB each because the canvas editor is baked
# into every published copy. The artboards (*.dc.html) and canvas.json beside
# them are the real source — a canvas is regenerated from those.
mockup/**/kinemos-analysis-viewer.html

# Machine-local symlink created by `npx skills add` into .agents/skills/.
# The skill itself is committed under .agents/skills/; this link is an
# absolute path, so it is not portable.
/.claude/skills/frontend-design

# Real-footage fixtures for the KinEMOS browser harnesses (large, local only)
verify/fixtures/
